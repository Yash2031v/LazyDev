{
  "name": "lazydev",
  "version": "0.1.0",
  "description": "Local-first open-weight AI developer assistant",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc && node -e \"fs.cpSync('src/client', 'dist/client', {recursive: true})\"",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "keywords": [
    "ai",
    "local-first",
    "ollama",
    "developer-assistant",
    "safe-automation"
  ],
  "author": "LazyDev Authors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
